# Calibra local / deploy placeholders — copy to .env.local and fill as needed.
# Do not put real secrets in the repo.

# Scheduler is OPT-IN (default off). Set to 1 to arm the auto-loop at boot (restart required).
# Leave unset/0 unless automation has been explicitly approved for this deployment.
CALIBRA_SCHEDULER=0

# Optional session override (local SQLite sessions work without this today).
CALIBRA_SESSION_SECRET=

# Optional SMTP for alert email (without these, emails queue to data/alert_outbox.json).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe — billing-ready placeholders; demo checkout works without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_API=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Scripts only: force bootstrap resolve path
# FORCE_BOOTSTRAP=1
